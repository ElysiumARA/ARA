{
  "$schema": "https://raw.githubusercontent.com/ElysiumARA/ARA/refs/heads/main/schema/v1/ara.schema.json",
  "system": {
    "name": "Contoso System",
    "version": "1.0.0",
    "customer": "Contoso"
  },
  "security": {
    "classification": "Public",
    "impactLevel": {
      "name": "IL2",
      "availability": "low",
      "confidentiality": "low",
      "integrity": "low"
    },
    "roles": [
      {
        "name": "System Administrator",
        "key": "sysadmin",
        "description": "Responsible for administration of Contoso System resources."
      },
      {
        "name": "Security Administrator",
        "key": "securityadmin",
        "description": "Responsible for security monitoring and compliance activities."
      }
    ],
    "stigs": []
  },
  "architecture": {
    "environments": [
      {
        "key": "dev",
        "resourceGroups": [
          {
            "name": "rg-ara-dev",
            "roles": [
              {
                "key": "sysadmin",
                "icamRoles": ["Contributor"]
              }
            ],
            "resources": [
              {
                "type": "Microsoft.Storage/storageAccounts",
                "name": "staradev001",
                "friendlyName": "Storage Account",
                "description": "Stores generated RMF artifacts.",
                "iacModule": {
                  "name": "storage",
                  "uri": "modules/storage/storage.bicep"
                },
                "roles": [
                  {
                    "key": "sysadmin",
                    "icamRoles": ["Storage Blob Data Contributor"]
                  }
                ],
                "software": [ "Azure Storage" ]
              }
            ]
          }
        ]
      },
      {
        "key": "test",
        "resourceGroups": [
          {
            "name": "rg-ara-test",
            "roles": [
              {
                "key": "sysadmin",
                "icamRoles": ["Contributor"]
              }
            ],
            "resources": [
              {
                "type": "Microsoft.Web/sites",
                "name": "app-ara-test",
                "friendlyName": "Web Application",
                "description": "Hosts the Azure RMF Agent UI.",
                "iacModule": {
                  "name": "webapp",
                  "uri": "modules/web/webapp.bicep"
                },
                "roles": [
                  {
                    "key": "sysadmin",
                    "icamRoles": ["Contributor"]
                  }
                ],
                "software": [ "Azure App Service" ]
              }
            ]
          }
        ]
      },
      {
        "key": "prod",
        "resourceGroups": [
          {
            "name": "rg-ara-prod",
            "roles": [
              {
                "key": "sysadmin",
                "icamRoles": ["Contributor"]
              },
              {
                "key": "securityadmin",
                "icamRoles": ["Security Admin"]
              }
            ],
            "resources": [
              {
                "type": "Microsoft.KeyVault/vaults",
                "name": "kv-ara-prod",
                "friendlyName": "Key Vault",
                "description": "Stores secrets and certificates.",
                "iacModule": {
                  "name": "keyvault",
                  "uri": "modules/security/keyvault.bicep"
                },
                "roles": [
                  {
                    "key": "securityadmin",
                    "icamRoles": ["Key Vault Administrator"]
                  }
                ],
                "software": [ "Azure Key Vault" ]
              },
              {
                "type": "Microsoft.Sql/servers",
                "name": "sql-ara-prod",
                "friendlyName": "Azure SQL Server",
                "description": "Hosts Azure RMF Agent data.",
                "linkedResources": [
                  {
                    "resourceGroup": "rg-ara-prod",
                    "type": "Microsoft.Sql/servers/databases",
                    "name": "ara",
                    "linkType": "Database"
                  }
                ],
                "roles": []
              },
              {
                "type": "Microsoft.Sql/servers/databases",
                "name": "ara",
                "friendlyName": "Azure SQL Database",
                "description": "Hosts Azure RMF Agent data.",
                "roles": []
              }
            ]
          }
        ]
      }
    ],
    "resourceTypes": [
      {
        "key": "Microsoft.Storage/storageAccounts",
        "friendlyName": "Azure Storage Account",
        "provider": "Azure"
      },
      {
        "key": "Microsoft.KeyVault/vaults",
        "friendlyName": "Azure Key Vault",
        "provider": "Azure"
      },
      {
        "key": "Microsoft.Sql/servers",
        "friendlyName": "Azure SQL Server",
        "provider": "Azure"
      },
      {
        "key": "Microsoft.Sql/servers/databases",
        "friendlyName": "Azure SQL Database",
        "provider": "Azure"
      }
    ],
    "software": [
      {
        "key": "ssms-19.3",
        "name": "SQL Server Management Studio",
        "version": "19.3",
        "description": "Integrated environment for managing any SQL infrastructure."
      },
      {
        "key": "azure-cli-2.58.",
        "name": "Azure CLI",
        "version": "2.58.0",
        "description": "Cross-platform command-line tool to connect to Azure and execute administrative commands on Azure resources."
      },
      {
        "key": "dotnet-framework-4.7.2",
        "name": ".NET Framework",
        "version": "4.7.2",
        "description": "Framework for building client and server applications."
      }
    ]
  }
}